# Cleanverse sandbox credentials (Service Partner). Gitignored. Do not commit.
# App ID  -> sent as the `api-id` request header (identifies your app)
CLEANVERSE_APP_ID=
# App Key -> Base64 AES key, used LOCALLY to encrypt request bodies. Never sent.
CLEANVERSE_APP_KEY=

# API surfaces
CLEANVERSE_COOPERATE_BASE=
CLEANVERSE_SKILLS_BASE=

# Chain
# NB: `cast` reads CHAIN as --chain and rejects "monad". Unset it before any cast call.
CHAIN=
MONAD_RPC_URL=

# Known sandbox addresses (Monad testnet)
APASS_ADDRESS=
AUSDC_ADDRESS=
USDC_ADDRESS=

# Testnet Wallet
W_PKEY=

# Second testnet wallet (verified seller)
W2_PKEY=

SETTLEMENT_ASSET=

SETTLEMENT_MODE=

NETWORK=

CHAIN_ID=

FACILITATOR_PKEY=

CX402_PROXY_SECRET=
CX402_DEMO_TOKEN=

# ---- Venue additions ----
POLICY_ADDRESS=
# Reference CVAs registered under the policy (someone else's, read-only)
REF_CVA_RVS=
REF_CVA_RVD=
# Filled in as they deploy

MOCK_POLICY_ADDRESS=
LISTED_ADDRESS=
CASH_ADDRESS=
SETTLEMENT_ADDRESS=

# Viewer A: credentialed at sub-tier 75 on the real CVI registry
VIEWER_A_PKEY=
